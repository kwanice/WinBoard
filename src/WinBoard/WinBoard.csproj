<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinBoard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>true</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged desktop app: F5 runs the EXE directly (no MSIX). -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxPackage>false</AppxPackage>
    <Version>0.1.0</Version>
    <Product>WinBoard</Product>
    <Description>Clavier tactile flottant bilingue FR/EN pour Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.251107005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Publish / packaging menu in Visual Studio (optional later MSIX). -->
  <ItemGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
    <ProjectCapability Include="HasPackageAndPublishMenu" />
  </ItemGroup>
</Project>
