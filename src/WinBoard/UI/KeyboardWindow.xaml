<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBoard.UI.KeyboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="WinBoard">

    <Grid x:Name="RootGrid">
        <Border
            x:Name="KeyboardRoot"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,8,10,10">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Touch-friendly drag chrome: 48px, GetPointerInfo screen coords so finger/stylus move the HWND. -->
                <Grid Height="48" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="SettingsButton"
                        Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnSettingsClicked"
                        Width="44"
                        Height="40"
                        Padding="0"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        ToolTipService.ToolTip="Réglages" />

                    <Grid
                        x:Name="DragHandle"
                        Grid.Column="1"
                        Background="Transparent"
                        ManipulationMode="TranslateX,TranslateY"
                        PointerPressed="OnDragHandlePointerPressed"
                        PointerMoved="OnDragHandlePointerMoved"
                        PointerReleased="OnDragHandlePointerReleased"
                        PointerCanceled="OnDragHandlePointerReleased"
                        PointerCaptureLost="OnDragHandlePointerReleased">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <Border Width="48" Height="5" CornerRadius="2.5" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="TitleText" Text="Glisser pour déplacer" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        </StackPanel>
                    </Grid>

                    <Button
                        Grid.Column="2"
                        Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnCloseClicked"
                        Width="44"
                        Height="40"
                        Padding="0"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        ToolTipService.ToolTip="Masquer (zone de notification)" />
                </Grid>

                <!-- Suggestion strip (swipe candidates) -->
                <ScrollViewer
                    x:Name="SuggestionScroller"
                    Grid.Row="1"
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel
                        x:Name="SuggestionBar"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center" />
                </ScrollViewer>

                <StackPanel
                    x:Name="KeysHost"
                    Grid.Row="2"
                    Spacing="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Swipe trail (drawn during a glide; never intercepts pointer input) -->
        <Canvas x:Name="SwipeTrail" IsHitTestVisible="False" />

        <!-- Settings overlay -->
        <Border
            x:Name="SettingsOverlay"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid Padding="20,16" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Réglages" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button
                            Content="Fermer"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="OnCloseSettingsClicked"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel Padding="0,0,8,8">
                            <TextBlock Text="Disposition" Style="{StaticResource SettingsSectionStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <RadioButtons x:Name="LayoutChoice" SelectionChanged="OnLayoutChoiceChanged" MaxColumns="2">
                                    <x:String>FR (AZERTY)</x:String>
                                    <x:String>EN (QWERTY)</x:String>
                                </RadioButtons>
                            </Border>

                            <TextBlock Text="Clavier" Style="{StaticResource SettingsSectionStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <ToggleSwitch x:Name="NumberRowToggle" Header="Rangée de chiffres (1–0)" Toggled="OnNumberRowToggled" />
                                    <ToggleSwitch x:Name="SecondaryGlyphToggle" Header="Symboles secondaires sur les touches" Toggled="OnSecondaryGlyphToggled" />
                                    <ToggleSwitch x:Name="OutlinesToggle" Header="Contours des touches lettres" Toggled="OnOutlinesToggled" />
                                    <ToggleSwitch x:Name="LongPressToggle" Header="Appui long (caractères spéciaux)" Toggled="OnLongPressToggled" />
                                    <ToggleSwitch x:Name="KeyRepeatToggle" Header="Répétition des touches" Toggled="OnKeyRepeatToggled" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Délai avant répétition (ms)" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Slider x:Name="RepeatDelaySlider" Minimum="150" Maximum="800" StepFrequency="10" ValueChanged="OnRepeatDelayChanged" />
                                    <TextBlock Text="Intervalle de répétition (ms)" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Slider x:Name="RepeatIntervalSlider" Minimum="20" Maximum="300" StepFrequency="5" ValueChanged="OnRepeatIntervalChanged" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Saisie par glissement" Style="{StaticResource SettingsSectionStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <ToggleSwitch x:Name="SwipeToggle" Header="Activer le swipe" Toggled="OnSwipeToggled" />
                                    <ToggleSwitch x:Name="SwipeTrailToggle" Header="Afficher le tracé" Toggled="OnSwipeTrailToggled" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Apparence" Style="{StaticResource SettingsSectionStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <RadioButtons x:Name="ThemeChoice" Header="Thème" SelectionChanged="OnThemeChoiceChanged" MaxColumns="2">
                                    <x:String>Sombre</x:String>
                                    <x:String>Clair</x:String>
                                </RadioButtons>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Transparence de la fenêtre" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Slider x:Name="OpacitySlider" Minimum="0.25" Maximum="1.0" StepFrequency="0.05" TickFrequency="0.05" ValueChanged="OnOpacityChanged" />
                                    <TextBlock Text="Taille du clavier" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Slider x:Name="SizeSlider" Minimum="0.70" Maximum="1.80" StepFrequency="0.02" TickFrequency="0.10" ValueChanged="OnSizeChanged" />
                                    <TextBlock Text="Taille des lettres (indépendante)" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Slider x:Name="FontSlider" Minimum="0.70" Maximum="1.60" StepFrequency="0.02" TickFrequency="0.10" ValueChanged="OnFontChanged" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Confidentialité" Style="{StaticResource SettingsSectionStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <TextBlock
                                    Text="Aucune donnée de saisie n’est collectée. 100 % local : pas de télémétrie, pas de cloud, pas d’envoi des frappes / swipes / presse-papiers."
                                    TextWrapping="Wrap" />
                            </Border>

                            <TextBlock
                                Text="Glisser la poignée du haut pour déplacer. La fenêtre reste au premier plan et ne vole jamais le focus (WS_EX_NOACTIVATE)."
                                TextWrapping="Wrap"
                                Opacity="0.7"
                                Margin="4,8,0,0"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock
                        x:Name="VersionText"
                        Grid.Row="2"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button
                        x:Name="QuitButton"
                        Grid.Row="2"
                        Content="Quitter"
                        HorizontalAlignment="Right"
                        Click="OnQuitClicked"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        ToolTipService.ToolTip="Quitter WinBoard" />
            </Grid>
        </Border>

        <!-- Emoji panel (Gboard-style categories + search + recents) -->
        <Border
            x:Name="EmojiOverlay"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid Padding="12,10" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Emoji" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        Content="Fermer"
                        HorizontalAlignment="Right"
                        Click="OnCloseEmojiClicked"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False" />
                </Grid>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EmojiCategoryBar" Orientation="Horizontal" Spacing="6" />
                </ScrollViewer>
                <Grid x:Name="EmojiSearchBar" Grid.Row="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="10,6"
                        MinHeight="40">
                        <TextBlock
                            x:Name="EmojiSearchQuery"
                            Text="Rechercher (lettres ci-dessous, pas de clavier système)"
                            Opacity="0.85"
                            TextWrapping="NoWrap" />
                    </Border>
                    <Button
                        Grid.Column="1"
                        Content="⌫"
                        Width="44"
                        Height="40"
                        Margin="6,0,0,0"
                        Click="OnEmojiSearchBackspace"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False" />
                    <Button
                        Grid.Column="2"
                        Content="Effacer"
                        Height="40"
                        Margin="6,0,0,0"
                        Click="OnEmojiSearchClear"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False" />
                </Grid>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel>
                        <Grid x:Name="EmojiLetterGrid" Visibility="Collapsed" Margin="0,0,0,8" />
                        <Grid x:Name="EmojiGridHost" />
                        <TextBlock
                            x:Name="EmojiEmpty"
                            Margin="8,16"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MyClipboard panel -->
        <Border
            x:Name="ClipsOverlay"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid Padding="20,16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="MyClipboard" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        Content="Fermer"
                        HorizontalAlignment="Right"
                        Click="OnCloseClipsClicked"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            x:Name="ClipsEmpty"
                            TextWrapping="Wrap"
                            Opacity="0.8"
                            Margin="0,8,0,8" />
                        <StackPanel x:Name="ClipsList" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Long-press special characters popup -->
        <primitives:Popup x:Name="LongPressPopup" IsLightDismissEnabled="False">
            <Border
                x:Name="LongPressContainer"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel x:Name="LongPressItems" Orientation="Horizontal" Spacing="2" />
            </Border>
        </primitives:Popup>
    </Grid>
</Window>
