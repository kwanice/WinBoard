<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBoard.UI.KeyboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="WinBoard">

    <Grid x:Name="RootGrid">
        <Border
            x:Name="KeyboardRoot"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,8,10,10">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Command / drag bar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="SettingsButton"
                        Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnSettingsClicked"
                        Width="36"
                        Height="30"
                        Padding="0"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        ToolTipService.ToolTip="Réglages" />

                    <!-- Drag region: moves the window without stealing focus. -->
                    <Grid
                        x:Name="DragHandle"
                        Grid.Column="1"
                        Background="Transparent"
                        PointerPressed="OnDragHandlePointerPressed"
                        PointerMoved="OnDragHandlePointerMoved"
                        PointerReleased="OnDragHandlePointerReleased"
                        PointerCanceled="OnDragHandlePointerReleased"
                        PointerCaptureLost="OnDragHandlePointerReleased">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="26" Height="4" CornerRadius="2" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="TitleText" Text="WinBoard" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                        </StackPanel>
                    </Grid>

                    <Button
                        Grid.Column="2"
                        Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnCloseClicked"
                        Width="36"
                        Height="30"
                        Padding="0"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        ToolTipService.ToolTip="Fermer" />
                </Grid>

                <StackPanel
                    x:Name="KeysHost"
                    Grid.Row="1"
                    Spacing="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Settings overlay -->
        <Border
            x:Name="SettingsOverlay"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid Padding="20" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Réglages" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button
                            Content="Fermer"
                            HorizontalAlignment="Right"
                            Click="OnCloseSettingsClicked"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="14" Padding="0,0,8,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Disposition" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <RadioButtons x:Name="LayoutChoice" SelectionChanged="OnLayoutChoiceChanged" MaxColumns="2">
                                    <x:String>FR (AZERTY)</x:String>
                                    <x:String>EN (QWERTY)</x:String>
                                </RadioButtons>
                            </StackPanel>

                            <ToggleSwitch x:Name="NumberRowToggle" Header="Rangée de chiffres" Toggled="OnNumberRowToggled" />
                            <ToggleSwitch x:Name="SecondaryGlyphToggle" Header="Symboles secondaires sur les touches" Toggled="OnSecondaryGlyphToggled" />
                            <ToggleSwitch x:Name="LongPressToggle" Header="Appui long (caractères spéciaux)" Toggled="OnLongPressToggled" />
                            <ToggleSwitch x:Name="KeyRepeatToggle" Header="Répétition des touches" Toggled="OnKeyRepeatToggled" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Délai avant répétition (ms)" />
                                <Slider x:Name="RepeatDelaySlider" Minimum="150" Maximum="800" StepFrequency="10" ValueChanged="OnRepeatDelayChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Intervalle de répétition (ms)" />
                                <Slider x:Name="RepeatIntervalSlider" Minimum="20" Maximum="300" StepFrequency="5" ValueChanged="OnRepeatIntervalChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Thème" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChoiceChanged" MaxColumns="2">
                                    <x:String>Sombre</x:String>
                                    <x:String>Clair</x:String>
                                </RadioButtons>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Opacité" />
                                <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1.0" StepFrequency="0.05" ValueChanged="OnOpacityChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Taille des touches" />
                                <Slider x:Name="SizeSlider" Minimum="0.8" Maximum="1.4" StepFrequency="0.05" ValueChanged="OnSizeChanged" />
                            </StackPanel>

                            <TextBlock
                                Text="La fenêtre reste au premier plan et ne vole jamais le focus (WS_EX_NOACTIVATE)."
                                TextWrapping="Wrap"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock
                        x:Name="VersionText"
                        Grid.Row="2"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <!-- Long-press special characters popup -->
        <primitives:Popup x:Name="LongPressPopup" IsLightDismissEnabled="False">
            <Border
                x:Name="LongPressContainer"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel x:Name="LongPressItems" Orientation="Horizontal" Spacing="2" />
            </Border>
        </primitives:Popup>
    </Grid>
</Window>
