<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBoard.UI.KeyboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinBoard">

    <Grid>
        <Border
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,10,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Drag region: title + gripper. Buttons live in the other column so they don't start a move. -->
                    <Grid
                        x:Name="DragHandle"
                        Background="Transparent"
                        PointerPressed="OnDragHandlePointerPressed"
                        PointerMoved="OnDragHandlePointerMoved"
                        PointerReleased="OnDragHandlePointerReleased"
                        PointerCanceled="OnDragHandlePointerReleased"
                        PointerCaptureLost="OnDragHandlePointerReleased">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border
                                Width="28"
                                Height="4"
                                CornerRadius="2"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="WinBoard"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="FrButton"
                            Content="FR"
                            Click="OnFrClicked"
                            Padding="14,6"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False"
                            ToolTipService.ToolTip="AZERTY (français)" />
                        <Button
                            x:Name="EnButton"
                            Content="EN"
                            Click="OnEnClicked"
                            Padding="14,6"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False"
                            ToolTipService.ToolTip="QWERTY (anglais)" />
                        <Button
                            Content="✕"
                            Click="OnCloseClicked"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Margin="6,0,0,0"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False"
                            ToolTipService.ToolTip="Fermer" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    x:Name="KeysHost"
                    Grid.Row="1"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
