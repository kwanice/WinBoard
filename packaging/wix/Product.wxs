<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1036"
           Version="$(var.ProductVersion)"
           Manufacturer="WinBoard"
           UpgradeCode="7E4B9A12-3C5D-4F8E-9A1B-2D6C8E0F4A3B">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="Une version plus recente de WinBoard est deja installee." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="WinBoardIcon.exe" SourceFile="$(var.SourceDir)\WinBoard.exe" />

    <Feature Id="ProductFeature" Title="WinBoard" Level="1">
      <ComponentGroupRef Id="AppHarvest" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="WinBoard" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WinBoard" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="8F3C2A91-5B4E-4D7C-9E1A-2F6B8D0C4E5F">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Clavier tactile flottant bilingue FR/EN pour Windows."
                  Target="[INSTALLFOLDER]WinBoard.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="WinBoardIcon.exe" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\WinBoard" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
